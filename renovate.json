{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump pinned ripgrep version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "ripgrep\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ripgrep",
      "packageNameTemplate": "nix_unstable/ripgrep",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned fd version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "fd\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "fd",
      "packageNameTemplate": "nix_unstable/fd",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned claude-code version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "claude-code\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "claude-code",
      "packageNameTemplate": "nix_unstable/claude-code",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned neovim version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "neovim\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "neovim",
      "packageNameTemplate": "nix_unstable/neovim",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned kubie version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "kubie\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "kubie",
      "packageNameTemplate": "nix_unstable/kubie",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned herdr version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "herdr\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "herdr",
      "packageNameTemplate": "nix_unstable/herdr",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned uv version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "uv\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "uv",
      "packageNameTemplate": "nix_unstable/uv",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned atuin version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "atuin\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "atuin",
      "packageNameTemplate": "nix_unstable/atuin",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump pinned pi-coding-agent version (Flox manifest pilot)",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "pi-coding-agent\\.version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "pi-coding-agent",
      "packageNameTemplate": "nix_unstable/pi-coding-agent",
      "datasourceTemplate": "repology"
    },
    {
      "customType": "regex",
      "description": "Bump zap flake ref to the latest tagged release",
      "fileMatch": ["^dot_flox/env/private_manifest\\.toml$"],
      "matchStrings": [
        "zap\\.flake = \"github:natejsimonsen/zap/(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "natejsimonsen/zap",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Force-recreate pinned Flox PRs each run so a failed flox-relock check gets retried once the catalog catches up",
      "matchDatasources": ["repology"],
      "recreateWhen": "always"
    }
  ]
}
